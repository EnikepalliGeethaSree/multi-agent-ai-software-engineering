# Copy to .env and fill in only what you use. Never commit .env.

# Provider and model. LLM_PROVIDER and GEMINI_MODEL win over MARL_LLM__* and over config files.
LLM_PROVIDER=gemini
GEMINI_API_KEY=REDACTED
GEMINI_MODEL=gemini-3.8-flash
# Get a free key at https://aistudio.google.com/apikey (no payment method needed).
# PRIVACY: on the free tier Google may use your prompts, which contain your code, to improve its
# products. Do not review confidential code this way. See docs/llm-gemini.md.

# Other providers (optional)
GROQ_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
# Local models (Ollama / vLLM / LM Studio OpenAI-compatible endpoint)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# GitHub integration (later)
GITHUB_TOKEN=

# PostgreSQL (optional, later)
DATABASE_URL=
