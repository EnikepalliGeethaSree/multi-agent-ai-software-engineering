LLM_PROVIDER=groq

# Groq Developer tier (pay-as-you-go): ONE key for the whole project. Never commit the real key.
GROQ_API_KEY=your_single_groq_api_key

# One model across all evaluations
GROQ_MODEL=openai/gpt-oss-120b

# Rate limits: copy them from the Groq console's limits page (TBD = not set)
GROQ_RPM=TBD
GROQ_TPM=TBD

# Optional usage caps. A token or spending cap is required before any Groq call.
GROQ_DAILY_REQUEST_LIMIT=TBD
GROQ_DAILY_TOKEN_LIMIT=TBD
GROQ_MAX_TOTAL_TOKENS=TBD
GROQ_MAX_ESTIMATED_COST_USD=TBD

# Prices from the Groq console, USD per million tokens (needed for cost estimates and the spending cap)
GROQ_INPUT_PRICE_PER_1M_TOKENS_USD=TBD
GROQ_OUTPUT_PRICE_PER_1M_TOKENS_USD=TBD

# Retry configuration
GROQ_MAX_RETRIES=5
GROQ_BASE_BACKOFF_SECONDS=2

# Other providers (historical / local)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=your_openai_api_key_here
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

GITHUB_TOKEN=
DATABASE_URL=
